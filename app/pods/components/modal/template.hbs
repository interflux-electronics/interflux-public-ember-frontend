{{#if this.modal.parent}}
  {{#in-element this.modal.parent}}
    <div id='modal' class={{this.theme}}>
      <div class='overlay'>
        <LinkTo @route={{this.parentRoute}} aria-label='Close' />
      </div>

      <div class='content' id={{@id}}>
        {{#if @loading}}
          <p>Loading ...</p>
        {{else if @error}}
          <div class='box error'>
            <Svg::Error />
            <RouteErrorMessage />
          </div>
        {{else}}
          <div class='box'>
            {{yield}}
          </div>
        {{/if}}
      </div>

      <Button
        @text={{t 'Close' 'modal.1'}}
        @icon='close'
        @theme='tertiary medium white-text icon-right'
        @route={{this.parentRoute}}
      />
    </div>
  {{/in-element}}
{{/if}}