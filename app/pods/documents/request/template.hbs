<Modal @id='request' @theme='centered'>
  <h2>{{t 'Request document' 'doc.new.23'}}</h2>
  <p>{{t 'In case you are unable to find the document you are looking for, feel free to ask our REACH officer.' 'doc.new.26'}}</p>
  <div class="buttons">
    <Button 
      @text={{t 'Back' 'doc.new.25'}}
      @theme="secondary medium grey-border blue-focus icon-right"
      @route="documents"
    />
    <Button 
      @text="reach@interflux.com" 
      @url={{this.mailto}} 
      @theme="medium primary orange icon-left" 
      @icon="email" 
    />
  </div>
</Modal>